# =============================================================================
# ParaSiteMedia — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=5000
API_VERSION=v1

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/agency_cms

# --- JWT ---
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Cookies ---
COOKIE_SECRET=your_cookie_secret_min_32_chars

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- SMTP (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=ParaSiteMedia
SMTP_FROM_EMAIL=noreply@agency.com

# --- Redis (Optional) ---
REDIS_URL=redis://localhost:6379

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Admin Seed ---
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@agency.com
ADMIN_PASSWORD=Admin@123456

# --- Frontend URL (for password reset links) ---
FRONTEND_URL=http://localhost:3000
